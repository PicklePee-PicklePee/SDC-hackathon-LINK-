# GitHub/RunPod builder: use the repository root as the build context.
# Select Dockerfile.runpod as the Dockerfile path.
# Only the GPU worker sources are copied, never the application or its secrets.
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY runpod/requirements.txt runpod/requirements-serverless.txt ./
RUN python -m pip install --no-cache-dir -r requirements-serverless.txt
COPY runpod/worker.py runpod/handler.py ./
ENV LINK_SERVERLESS=1 \
    LINK_DATA_DIR=/runpod-volume/link-data \
    HF_HOME=/runpod-volume/huggingface \
    PYTHONUNBUFFERED=1
CMD ["python", "-u", "handler.py"]
